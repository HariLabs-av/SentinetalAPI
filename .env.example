# Backend runtime
HOST=0.0.0.0
PORT=8000
SENTINELAPI_ALLOW_PRIVATE_TARGETS=false
SENTINELAPI_CORS_ORIGINS=http://127.0.0.1:5500
SENTINELAPI_MAX_RESPONSE_BYTES=1048576
SENTINELAPI_REQUEST_TIMEOUT=5
SENTINELAPI_MAX_WORKERS=8

