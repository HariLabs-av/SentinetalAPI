GEMINI_API_KEY=replace-with-a-new-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=20
AI_PROVIDER=groq
GROQ_API_KEY=replace-with-a-new-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=20
